# PostgreSQL connection string.
# Local:  postgresql://postgres:postgres@localhost:5432/finance_dashboard
# Railway/Render/Supabase: paste the connection string they give you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_dashboard"

# Secret used to sign JWTs. Generate a long random string for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated list of allowed frontend origins. Use * only in dev.
CORS_ORIGIN="http://localhost:5173"

# Server port
PORT=4000

NODE_ENV="development"
